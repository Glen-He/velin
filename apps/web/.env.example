NODE_ENV=development
PORT=3000
HOST=127.0.0.1
# 仅当受控反向代理连接此服务时配置其具体 IP；留空时只信任实际 socket 地址。
# 代理必须覆盖或追加 X-Forwarded-For，不能直接透传不受信任的左端地址。
TRUSTED_PROXY_ADDRESSES=
DATABASE_URL=postgresql://YOUR_LOCAL_USER@localhost:5432/velin_dev
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
APP_URL=http://localhost:3000
PASSKEY_RP_ID=localhost

# DeepSeek API Key 只在服务端使用；未配置时本地认证仍可启动，但对话不可用。
DEEPSEEK_API_KEY=
CHAT_DAILY_LIMIT_PER_USER=30
CHAT_DAILY_LIMIT_GLOBAL=300
CHAT_MINUTE_LIMIT_PER_USER=5

# Google OAuth（生产环境必填）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 本地开发可用 console；生产环境必须改为 smtp。
EMAIL_TRANSPORT=console
EMAIL_FROM=Velin <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
