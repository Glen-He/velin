{
  "name": "@velin/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "dev": "NODE_ENV=development node --env-file-if-exists=.env.local --import tsx scripts/web-server.ts development",
    "build": "next build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env.local --import tsx scripts/web-server.ts production",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/generate-auth-schema.ts",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx src/lib/database/migrate.ts up",
    "db:rollback": "node --env-file-if-exists=.env.local --import tsx src/lib/database/migrate.ts down",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts && node --import tsx --test tests/rendering/*.test.ts",
    "test:pages": "next build && node --conditions=react-server --import tsx --test tests/framework/*.test.ts"
  },
  "dependencies": {
    "@better-auth/electron": "1.7.6",
    "@better-auth/passkey": "1.7.6",
    "better-auth": "1.7.6",
    "node-pg-migrate": "9.0.0",
    "nodemailer": "10.0.11",
    "openai": "7.23.0",
    "pg": "8.23.0",
    "zod": "4.6.5",
    "@velin/contracts": "workspace:*",
    "lucide-react": "1.48.0",
    "qr-code-styling": "1.9.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-easy-crop": "^6.2.3",
    "@velin/ui": "workspace:*",
    "next": "16.3.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
