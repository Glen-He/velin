{
  "name": "@velin/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "account:access": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/account-access.ts",
    "eval:memory": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/evaluate-memory.ts",
    "dev": "NODE_ENV=development node --env-file-if-exists=.env.local --import tsx scripts/web-server.ts development",
    "build": "node --import tsx scripts/next-cli.ts build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env.local --import tsx scripts/web-server.ts production",
    "ocr:worker": "NODE_ENV=development node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/ocr-worker.ts",
    "ocr:worker:prod": "NODE_ENV=production node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/ocr-worker.ts",
    "typecheck": "node --import tsx scripts/next-cli.ts typegen && tsc --noEmit",
    "db:generate": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/generate-auth-schema.ts",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx src/lib/database/migrate.ts up",
    "db:rollback": "node --env-file-if-exists=.env.local --import tsx src/lib/database/migrate.ts down",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts && node --conditions=react-server --import tsx --test --test-concurrency=1 tests/runtime/*.test.ts && node --import tsx --test tests/rendering/*.test.ts",
    "test:pages": "pnpm build && node --conditions=react-server --import tsx --test tests/framework/*.test.ts",
    "test:ocr-load": "VELIN_OCR_LOAD_TEST=1 node --conditions=react-server --import tsx --test tests/runtime/ocr-load.test.ts"
  },
  "dependencies": {
    "@better-auth/electron": "1.7.6",
    "@better-auth/passkey": "1.7.6",
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@velin/contracts": "workspace:*",
    "@velin/ui": "workspace:*",
    "better-auth": "1.7.6",
    "exceljs": "4.4.0",
    "lucide-react": "1.48.0",
    "next": "16.4.1",
    "node-pg-migrate": "9.0.0",
    "nodemailer": "10.0.11",
    "officeparser": "8.2.0",
    "openai": "7.23.0",
    "pdfjs-dist": "6.2.108",
    "pg": "8.23.0",
    "pg-boss": "12.38.0",
    "qr-code-styling": "1.9.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-easy-crop": "^6.2.3",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tesseract.js": "7.0.0",
    "tsx": "4.23.15",
    "yauzl": "3.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "2.10.3",
    "typescript": "7.0.2"
  }
}
