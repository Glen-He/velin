{
  "name": "@velin/auth-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "dev": "node --watch-path=src --env-file-if-exists=.env.local --import tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env.local dist/server.js",
    "db:generate": "auth generate --config src/auth.ts --output migrations/generated.sql -y",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx src/database/migrate.ts up",
    "db:rollback": "node --env-file-if-exists=.env.local --import tsx src/database/migrate.ts down",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@better-auth/electron": "1.7.6",
    "@better-auth/passkey": "1.7.6",
    "@hono/node-server": "2.1.1",
    "better-auth": "1.7.6",
    "hono": "4.13.9",
    "node-pg-migrate": "9.0.0",
    "nodemailer": "10.0.11",
    "openai": "7.23.0",
    "pg": "8.23.0",
    "zod": "4.6.5",
    "@velin/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "auth": "1.7.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
