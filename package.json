{
  "name": "velin",
  "productName": "Velin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names auth,web,desktop --prefix-colors cyan,magenta,green \"pnpm --filter @velin/auth-server dev\" \"pnpm --filter @velin/auth-web dev\" \"vite\"",
    "dev:desktop": "vite",
    "build": "pnpm --filter @velin/auth-web build && pnpm --filter @velin/auth-server build && tsc -b && vite build",
    "typecheck": "pnpm --filter @velin/auth-web typecheck && pnpm --filter @velin/auth-server typecheck && tsc -b",
    "lint": "oxlint .",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "db:generate": "pnpm --filter @velin/auth-server db:generate",
    "db:migrate": "pnpm --filter @velin/auth-server db:migrate",
    "db:rollback": "pnpm --filter @velin/auth-server db:rollback"
  },
  "dependencies": {
    "@better-auth/electron": "1.7.6",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@streamdown/code": "1.1.1",
    "better-auth": "1.7.6",
    "conf": "15.1.0",
    "eventsource-parser": "4.1.1",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-easy-crop": "^6.2.3",
    "react-resizable-panels": "4.14.1",
    "streamdown": "2.6.0"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "electron": "44.4.5",
    "oxlint": "1.85.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vite-plugin-electron": "1.1.2"
  }
}
